<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.kojic.ibmi</id>
    <name>IBM i Helper</name>
    <vendor>Kojic</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="ibmi-withDatabase.xml">com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.milutink.ibmiintellijplugin.toolWindow.MyToolWindowFactory"
                    id="IBM i Helper"
                    anchor="right"/>
        <postStartupActivity implementation="com.github.milutink.ibmiintellijplugin.hover.IbmiHoverActivity" />
        <projectService serviceImplementation="com.github.milutink.ibmiintellijplugin.services.DatabaseService"/>
        <projectService serviceImplementation="com.github.milutink.ibmiintellijplugin.hover.IbmiHoverService"/>
        <statusBarWidgetFactory implementation="com.github.milutink.ibmiintellijplugin.statusBar.IbmiStatusBarWidgetFactory"
                                id="IbmiConnectionStatus"/>
        <completion.contributor language="any"
                                implementationClass="com.github.milutink.ibmiintellijplugin.completion.IbmiCompletionContributor"/>
    </extensions>
</idea-plugin>
